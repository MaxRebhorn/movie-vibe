# Dockerfile.ci
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=off \
    TRANSFORMERS_CACHE=/cache/transformers \
    TORCH_HOME=/cache/torch \
    SENTENCE_TRANSFORMERS_HOME=/cache/sentence_transformers

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    docker.io \
    && dpkg -l | tee /dpkg-list.txt \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -SL https://github.com/docker/compose/releases/download/v2.27.1/docker-compose-linux-x86_64 \
         -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

COPY requirements-test.txt ./

RUN pip install --upgrade pip && \
    pip install --no-cache-dir --no-deps -r requirements-test.txt && \
    pip freeze | tee /pip-freeze.txt

COPY . .

RUN mkdir -p /cache/transformers /cache/torch /cache/sentence_transformers

# Dump environment variables for inspection
RUN env | tee /env.txt

# Search for NVIDIA, CUDA, cuDNN files in common paths (ignore errors)
RUN find /usr /lib /etc -iname "*nvidia*" -o -iname "*cuda*" -o -iname "*cudnn*" 2>/dev/null | tee /nvidia-files.txt || true
